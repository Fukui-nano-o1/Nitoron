        },
        {
          "id": "cb311f16-026",
          "type": "text",
          "text": "TA701N は GB181、TA801N は GB221 で、型式によって排気量と出力が違う。オイルは0.55 L。燃料タンクは2.8 L で残量が見える樹脂製。"
        },
        {
          "id": "cb311f16-027",
          "type": "bullet",
          "text": "エンジン型式：GB181（TA701N）／GB221（TA801N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-028",
          "type": "bullet",
          "text": "種類：空冷4サイクル傾斜型OHVガソリンエンジン（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-029",
          "type": "bullet",
          "text": "総排気量：0.181 L｛181 cc｝（TA701N）／0.215 L｛215 cc｝（TA801N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-030",
          "type": "bullet",
          "text": "出力：3.3 kW｛4.5 PS｝/1700 rpm（TA701N）／3.7 kW｛5.0 PS｝/1700 rpm（TA801N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-031",
          "type": "bullet",
          "text": "最大出力：4.6 kW｛6.3 PS｝（TA701N）／5.1 kW｛7.0 PS｝（TA801N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-032",
          "type": "bullet",
          "text": "使用燃料：自動車用レギュラーガソリン（無鉛）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-033",
          "type": "bullet",
          "text": "燃料タンク容量：2.8 L（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-034",
          "type": "bullet",
          "text": "始動方式：リコイルスタータ式（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-035",
          "type": "bullet",
          "text": "エンジンオイル：クボタ純オイル（ガソリンエンジン用）スーパーG 10W-30・0.55 L（印刷p.40／PDF 44） — 交換の目安は初回20時間、以後50時間ごと（同頁の表）。やり方は印刷p.42。"
        },
        {
          "id": "cb311f16-036",
          "type": "bullet",
          "text": "点火プラグ：スパークプラグ LE010-1378-0（全機種共通）（印刷p.56／PDF 60） — 調節・清掃は6か月に1回（印刷p.40の表）。やり方は印刷p.44。"
        },
        {
          "id": "cb311f16-037",
          "type": "bullet",
          "text": "エアクリーナ：オイルパン式。規定量は[OIL LEVEL]まで（印刷p.40／PDF 44） — ホコリの多いときは毎日清掃、エレメントとオイルは50時間ごとに交換（同頁）。やり方は印刷p.43。"
        },
        {
          "id": "cb311f16-038",
          "type": "bullet",
          "text": "燃料タンク（製品ページ）：エンジン上部の2.8 L 樹脂製タンク。残量が見え、自然落下方式（製品ページ・2026-09-15）"
        },
        {
          "id": "cb311f16-039",
          "type": "h2",
          "text": "走行部"
        },
        {
          "id": "cb311f16-040",
          "type": "text",
          "text": "主変速はハンドル正位置で前進6段・後進3段、逆位置で前進4段・後進3段。SC仕様は左右の操向クラッチを持つ。車軸は六角で、輪距を調節できる。"
        },
        {
          "id": "cb311f16-041",
          "type": "bullet",
          "text": "車輪：3.50-7（K・SCK）／4.00-7（SCJ）／16×7.00-8（SCW）／ゴムラグ車輪（TA801N-N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-042",
          "type": "bullet",
          "text": "輪距：200・250 mm（K）／190〜290 mm（SCK）／190〜490 mm（SCJ）／265〜515 mm（SCW）／120 mm（TA801N-N）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-043",
          "type": "bullet",
          "text": "主クラッチ方式：ベルトテンション式（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-044",
          "type": "bullet",
          "text": "操向クラッチ方式：SC仕様はボール式、K・N はなし（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-045",
          "type": "bullet",
          "text": "変速段数：ハンドル正位置 前進6・後進3、逆位置 前進4・後進3（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-046",
          "type": "bullet",
          "text": "走行速度（ハンドル正位置）：前進 0.55〜3.7 km/h・後進 0.52〜1.1 km/h（3.50-7）ほか、タイヤ径で変わる（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-047",
          "type": "bullet",
          "text": "車軸の形状・寸法：六角 対辺23 mm。ホイールチューブは六角（内対辺23・外対辺32 mm）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-048",
          "type": "bullet",
          "text": "PTO回転速度：791 rpm（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-049",
          "type": "bullet",
          "text": "ミッションオイル：クボタ純オイル（ミッション用）スーパーUDT2・2.4 L（印刷p.40／PDF 44） — 交換の目安は初回20時間、以後1年ごと（同頁の表）。やり方は印刷p.43。"
        },
        {
          "id": "cb311f16-050",
          "type": "bullet",
          "text": "走行速度一覧表：タイヤ径350・400・412 mm ごとの各段の速度。定格回転1700 rpm（印刷p.54／PDF 58）"
        },
        {
          "id": "cb311f16-051",
          "type": "bullet",
          "text": "主クラッチケーブル：使用初期は5時間使用後に調節、その後は必要に応じて（印刷p.40／PDF 44） — やり方は印刷p.46。"
        },
        {
          "id": "cb311f16-052",
          "type": "bullet",
          "text": "タイヤ空気圧：空気圧異常時に調節（印刷p.40／PDF 44） — やり方は印刷p.45。"
        },
        {
          "id": "cb311f16-053",
          "type": "bullet",
          "text": "広幅タイヤ（W仕様・製品ページ）：標準タイヤ（J仕様）に比べ幅が約1.5倍（製品ページ・2026-09-15）"
        },
        {
          "id": "cb311f16-054",
          "type": "h2",
          "text": "作業部"
        },
        {
          "id": "cb311f16-055",
          "type": "text",
          "text": "本機はアタッチメントを付けて使う管理機で、PTOレバーでロータリへの動力を入切する。フロントヒッチにウェイトを付けられる。"
        },
        {
          "id": "cb311f16-056",
          "type": "bullet",
          "text": "全長：1555 mm（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-057",
          "type": "bullet",
          "text": "全幅：625 mm（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-058",
          "type": "bullet",
          "text": "全高：1120 mm（K・N）／1145 mm（SCK）／1150 mm（SCJ・SCW）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-059",
          "type": "bullet",
          "text": "機体質量：71 kg（TA701N-K）／74 kg（SCK）／76 kg（SCJ）／81 kg（SCW）／TA801N は68・75・77・82 kg（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-060",
          "type": "bullet",
          "text": "PTOレバー：[入]でロータリへ動力が伝わり、[切]で止まる。後進時はロータリが回らない（印刷p.23／PDF 27）"
        },
        {
          "id": "cb311f16-061",
          "type": "bullet",
          "text": "PTO牽制金具：ハンドル逆位置で前進作業するときは[切]、正位置の作業では[入]に戻す（印刷p.24／PDF 28）"
        },
        {
          "id": "cb311f16-062",
          "type": "bullet",
          "text": "六角ホイールチューブ［N仕様以外］：作業に応じて輪距を調節できる。やり方は印刷p.36（印刷p.24／PDF 28）"
        },
        {
          "id": "cb311f16-063",
          "type": "bullet",
          "text": "ハンドル回転：-22.5・0・22.5・45・157.5・180・202.5 度（レバーワンタッチ式）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-064",
          "type": "bullet",
          "text": "ハンドル上下調節：4段（レバーワンタッチ式）（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-065",
          "type": "bullet",
          "text": "フロントヒッチ（製品ページ）：最大30 kg までのウェイトを装着できる（製品ページ・2026-09-15）"
        },
        {
          "id": "cb311f16-066",
          "type": "bullet",
          "text": "アタッチメント（製品ページ）：ハッスルシリーズ（平高うね・小うね・平うねのロータリマルチ、テープシーダー等）（製品ページ・2026-09-15）"
        },
        {
          "id": "cb311f16-067",
          "type": "h2",
          "text": "操作方法"
        },
        {
          "id": "cb311f16-068",
          "type": "text",
          "text": "主クラッチはハンドルの主クラッチレバーでもフィンガーレバーでも操作でき、補助主クラッチレバーで走行とPTOを同時に止められる。ハンドルは高さ4段と回動ができる。"
        },
        {
          "id": "cb311f16-069",
          "type": "bullet",
          "text": "主クラッチレバー：[入]位置でクラッチが入り、[切]位置で切れる（印刷p.18／PDF 22）"
        },
        {
          "id": "cb311f16-070",
          "type": "bullet",
          "text": "フィンガーレバー：主クラッチと連動。押し下げで入、押し上げで切（印刷p.18／PDF 22）"
        },
        {
          "id": "cb311f16-071",
          "type": "bullet",
          "text": "メインスイッチ：押しながら[運転]に回すと始動できる。押すと[停止]に戻る（印刷p.18／PDF 22）"
        },
        {
          "id": "cb311f16-072",
          "type": "bullet",
          "text": "補助主クラッチレバー：非常時に押し下げると主クラッチが切れ、走行とPTOが止まる（印刷p.18／PDF 22）"
        },
        {
          "id": "cb311f16-073",
          "type": "bullet",
          "text": "スロットルレバー：[高]で回転が上がり、[低]で下がる（印刷p.19／PDF 23）"
        },
        {
          "id": "cb311f16-074",
          "type": "bullet",
          "text": "ハンドル高さ調節レバー：4段。レバーを押すと上下に動き、離すと固定（印刷p.19／PDF 23）"
        },
        {
          "id": "cb311f16-075",
          "type": "bullet",
          "text": "操向クラッチレバー［SC仕様］：右を握ると右旋回、左を握ると左旋回（印刷p.19／PDF 23）"
        },
        {
          "id": "cb311f16-076",
          "type": "bullet",
          "text": "操向クラッチ切替えボタン［SC仕様］：ハンドル位置を変えるときは同時に切り替える（印刷p.19／PDF 23）"
        },
        {
          "id": "cb311f16-077",
          "type": "bullet",
          "text": "ハンドル回動レバー：[解除]で正位置・逆位置に回動。正位置は右2段・左1段、逆位置は左右各1段の角度調節（印刷p.20／PDF 24）"
        },
        {
          "id": "cb311f16-078",
          "type": "bullet",
          "text": "リコイルスタータ：主クラッチ切・主変速中立・メインスイッチ運転で引いて始動（印刷p.21／PDF 25）"
        },
        {
          "id": "cb311f16-079",
          "type": "bullet",
          "text": "チョークレバー：始動時は「始動」、始動後は「運転」（印刷p.21／PDF 25）"
        },
        {
          "id": "cb311f16-080",
          "type": "bullet",
          "text": "燃料コックレバー：[ON]が開、[OFF]が閉。停止後は必ず[OFF]（印刷p.21／PDF 25）"
        },
        {
          "id": "cb311f16-081",
          "type": "bullet",
          "text": "燃料タンクの規定量：2.8 L（印刷p.22／PDF 26）"
        },
        {
          "id": "cb311f16-082",
          "type": "bullet",
          "text": "主変速レバー：レバー根元を持ち上げて回動し、案内板の表示に合わせる（印刷p.23／PDF 27）"
        },
        {
          "id": "cb311f16-083",
          "type": "bullet",
          "text": "高速牽制ボルト：[入]位置では前進6速に入らない（印刷p.23／PDF 27）"
        },
        {
          "id": "cb311f16-084",
          "type": "h2",
          "text": "安全に使うために"
        },
        {
          "id": "cb311f16-085",
          "type": "text",
          "text": "安全の章は印刷p.3〜12。作業条件はここでは要約せず、該当頁を指す。前進6速の制限は諸元表にも警告として載っている。"
        },
        {
          "id": "cb311f16-086",
          "type": "bullet",
          "text": "正しい運転方法・運転してはいけない人（16才未満など）・服装：印刷p.3（印刷p.3／PDF 7）"
        },
        {
          "id": "cb311f16-087",
          "type": "bullet",
          "text": "周囲への注意・貸すとき・給油注油・排ガス：印刷p.4（印刷p.4／PDF 8）"
        },
        {
          "id": "cb311f16-088",
          "type": "bullet",
          "text": "発進・ロータ装着時の後進禁止・移動・ハウス車庫内：印刷p.5（印刷p.5／PDF 9）"
        },
        {
          "id": "cb311f16-089",
          "type": "bullet",
          "text": "坂道・運搬や積降ろし・耕うん作業：印刷p.6（印刷p.6／PDF 10）"
        },
        {
          "id": "cb311f16-090",
          "type": "bullet",
          "text": "回転している爪・ほ場がかたいとき・機械から離れるとき・ハンドル回動：印刷p.7（印刷p.7／PDF 11）"
        },
        {
          "id": "cb311f16-091",
          "type": "bullet",
          "text": "PTO軸を使うとき・掃除・点検整備・カバー類：印刷p.8（印刷p.8／PDF 12）"
        },
        {
          "id": "cb311f16-092",
          "type": "bullet",
          "text": "タイヤの確認・改造禁止・格納・廃棄物：印刷p.9（印刷p.9／PDF 13）"
        },
        {
          "id": "cb311f16-093",
          "type": "bullet",
          "text": "夜間作業の禁止・作業機の着脱：印刷p.10（印刷p.10／PDF 14）"
        },
        {
          "id": "cb311f16-094",
          "type": "bullet",
          "text": "安全ラベルと貼付け位置：印刷p.11（印刷p.11／PDF 15）"
        },
        {
          "id": "cb311f16-095",
          "type": "bullet",
          "text": "前進6速の警告：草削りロータ（直径300 mm）の作業以外では高速牽制ボルトを[入]に固定する（印刷p.52／PDF 56）"
        },
        {
          "id": "cb311f16-096",
          "type": "h2",
          "text": "整備と点検（索引）"
        },
        {
          "id": "cb311f16-097",
          "type": "text",
          "text": "「定期点検箇所一覧表」と「管理機の給油一覧表」が同じ頁にある。巻末に「トラブルと処置」の表と索引がある。"
        },
        {
          "id": "cb311f16-098",
          "type": "bullet",
          "text": "定期点検箇所一覧表：主クラッチケーブル（初期5時間後）／エンジンオイル（初回20時間、以後50時間ごと）／ミッションオイル（初回20時間、以後1年ごと）／エアクリーナ（毎日清掃、50時間ごと交換）／燃料フィルタ（50時間ごと）・タンク（300時間ごと）／点火プラグ（6か月に1回）／タイヤ空気圧・ハンドル上下・操向クラッチ・PTOケーブル・スタンド・スロットルレバー（必要に応じて）／燃料チューブ（2年ごと）／ファンカバー（印刷p.40／PDF 44）"
        },
        {
          "id": "cb311f16-099",
          "type": "bullet",
          "text": "管理機の給油一覧表：燃料2.8 L／エンジン0.55 L／ミッション2.4 L／エアクリーナは[OIL LEVEL]まで（印刷p.40／PDF 44）"
        },
        {
          "id": "cb311f16-100",
          "type": "bullet",
          "text": "日常点検（燃料・エンジンオイル・ミッションオイル）：印刷p.41（印刷p.41／PDF 45）"
        },
