        },
        {
          "id": "d41e8089-024",
          "type": "text",
          "text": "TMS300 と同じ GB101 エンジン。定格の回転が3600 rpm と高く、燃料タンクは1.4 L と大きい。"
        },
        {
          "id": "d41e8089-025",
          "type": "bullet",
          "text": "エンジン型式：GB101（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-026",
          "type": "bullet",
          "text": "種類：空冷4サイクル傾斜型OHVガソリンエンジン（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-027",
          "type": "bullet",
          "text": "総排気量：0.098 L｛98 cc｝（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-028",
          "type": "bullet",
          "text": "連続定格出力：1.6 kW｛2.2 PS｝/3600 rpm（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-029",
          "type": "bullet",
          "text": "最大出力：2.2 kW｛3.0 PS｝（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-030",
          "type": "bullet",
          "text": "使用燃料：自動車用レギュラーガソリン（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-031",
          "type": "bullet",
          "text": "燃料タンク容量：1.4 L（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-032",
          "type": "bullet",
          "text": "始動方式：リコイルスタータ式（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-033",
          "type": "bullet",
          "text": "エンジンオイル：クボタ純オイル（ガソリンエンジン用）スーパーG 10W-30・0.4 L（印刷p.36／PDF 40） — 交換の目安は初回20時間、以後50時間ごと（印刷p.36の表）。やり方は印刷p.37。"
        },
        {
          "id": "d41e8089-034",
          "type": "bullet",
          "text": "点火プラグ：NGK BPR6HS。電極のすきま 0.6 mm〜0.7 mm、点検調節は6か月に1回（印刷p.40／PDF 44） — やり方は同頁。"
        },
        {
          "id": "d41e8089-035",
          "type": "bullet",
          "text": "エアクリーナ：湿式エレメント。オイル量は約2.5 g（印刷p.39／PDF 43） — ホコリの多いときは毎日清掃、エレメントは50時間ごとに交換（同頁の表）。方法は印刷p.38〜39。"
        },
        {
          "id": "d41e8089-036",
          "type": "bullet",
          "text": "ファンカバー吸気口：ゴミやワラクズが付くと過熱や出力低下の原因になると説明されている（印刷p.40／PDF 44）"
        },
        {
          "id": "d41e8089-037",
          "type": "h2",
          "text": "走行部"
        },
        {
          "id": "d41e8089-038",
          "type": "text",
          "text": "車輪付きのリアロータリ機。主クラッチはベルトテンション式、デフ式の操向クラッチ（ロック付）、前進2段・後進1段。"
        },
        {
          "id": "d41e8089-039",
          "type": "bullet",
          "text": "車輪（タイヤ）：3.50-6（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-040",
          "type": "bullet",
          "text": "輪距（外幅）：365 mm（外幅460 mm）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-041",
          "type": "bullet",
          "text": "主クラッチ方式：ベルトテンション式（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-042",
          "type": "bullet",
          "text": "操向クラッチ方式：デフ式（ロック付）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-043",
          "type": "bullet",
          "text": "変速段数：前進2段、後進1段（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-044",
          "type": "bullet",
          "text": "走行速度（定格回転時）：前進 0.82・4.21 km/h、後進 0.82 km/h（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-045",
          "type": "bullet",
          "text": "車軸の形状・寸法：丸棒・直径20 mm（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-046",
          "type": "bullet",
          "text": "ミッションオイル：クボタ純オイル（ミッション用）M80B またはスーパーUDT-2・1.9 L（印刷p.36／PDF 40） — 交換の目安は初回20時間、以後1年ごと（同頁の表）。やり方は印刷p.38。"
        },
        {
          "id": "d41e8089-047",
          "type": "bullet",
          "text": "主クラッチケーブル：使用初期は5時間使用後に調節、その後は必要に応じて（印刷p.36／PDF 40） — やり方は印刷p.41。"
        },
        {
          "id": "d41e8089-048",
          "type": "bullet",
          "text": "デフ連動ロータリ入切レバー：[直進・作業]でデフロックとロータリ入、[旋回]でデフ差動とロータリ切（印刷p.17／PDF 21）"
        },
        {
          "id": "d41e8089-049",
          "type": "bullet",
          "text": "タイヤ空気圧：空気の抜けがあれば必要に応じて調節（印刷p.36／PDF 40） — やり方は印刷p.41。"
        },
        {
          "id": "d41e8089-050",
          "type": "h2",
          "text": "作業部"
        },
        {
          "id": "d41e8089-051",
          "type": "text",
          "text": "センタードライブのリアロータリ。爪軸の回転が型式で違い、USD は逆転が速い。耕幅は450 mm。"
        },
        {
          "id": "d41e8089-052",
          "type": "bullet",
          "text": "ロータリ駆動方式：センタードライブ（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-053",
          "type": "bullet",
          "text": "ロータリ変速段数：正転1・逆転1（D・USD）／一軸正逆転1（HD）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-054",
          "type": "bullet",
          "text": "爪軸回転速度（定格回転時）：正転225・逆転225 rpm（D）／正転部225・逆転部225 rpm（HD）／正転225・逆転343 rpm（USD）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-055",
          "type": "bullet",
          "text": "耕幅：450 mm（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-056",
          "type": "bullet",
          "text": "爪回転径：310 mm（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-057",
          "type": "bullet",
          "text": "爪の種類：正逆爪（D・USD）／ナタ爪（HD）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-058",
          "type": "bullet",
          "text": "爪軸の形状・寸法：丸棒・直径20 mm（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-059",
          "type": "bullet",
          "text": "ロータリカバー形状：固定式（D・HD）／開閉式（USD）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-060",
          "type": "bullet",
          "text": "全長（収納時）：1285 mm（収納時 990 mm または 1050 mm、型式による）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-061",
          "type": "bullet",
          "text": "全幅：490 mm または 525 mm（型式による）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-062",
          "type": "bullet",
          "text": "全高（収納時）：1050 mm（収納時 785 mm）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-063",
          "type": "bullet",
          "text": "機体質量：55 kg（D）／62 kg（HD）／57 kg（USD）（印刷p.49／PDF 53）"
        },
        {
          "id": "d41e8089-064",
          "type": "bullet",
          "text": "簡単うね立てマット：うね立てに使う。D・HD に装備（印刷p.20／PDF 24） — セットのやり方は印刷p.29〜30。"
        },
        {
          "id": "d41e8089-065",
          "type": "bullet",
          "text": "抵抗棒：耕うん・うね立て時の耕深調節に使う（印刷p.20／PDF 24） — 型式ごとの耕深調節は印刷p.31〜34。"
        },
        {
          "id": "d41e8089-066",
          "type": "bullet",
          "text": "耕うん爪の交換：磨耗・曲がり・損傷があれば交換。D は印刷p.42、HD は印刷p.43、USD は印刷p.44（印刷p.36／PDF 40）"
        },
        {
          "id": "d41e8089-067",
          "type": "h2",
          "text": "操作方法"
        },
        {
          "id": "d41e8089-068",
          "type": "text",
          "text": "主クラッチ・デフ連動の入切レバー・主変速・メインスイッチ・スロットルを手元で操作し、燃料コック・チョーク・クイックドレインはエンジン側にある。"
        },
        {
          "id": "d41e8089-069",
          "type": "bullet",
          "text": "主クラッチレバー：握ると入、離すと切（印刷p.17／PDF 21）"
        },
        {
          "id": "d41e8089-070",
          "type": "bullet",
          "text": "主変速レバー：前進2段・後進1段。ロータリは正転1・逆転1（HD は一軸正逆転1）（印刷p.17／PDF 21）"
        },
        {
          "id": "d41e8089-071",
          "type": "bullet",
          "text": "メインスイッチ：押しながら[運転]位置に回すと始動できる。押すと[停止]に戻る（印刷p.18／PDF 22）"
        },
        {
          "id": "d41e8089-072",
          "type": "bullet",
          "text": "スロットルレバー：[高]で回転が上がり、[低]で下がる（印刷p.18／PDF 22）"
        },
        {
          "id": "d41e8089-073",
          "type": "bullet",
          "text": "燃料コックレバー：[C]が閉、[O]が開。停止後は必ず閉（印刷p.18／PDF 22）"
        },
        {
          "id": "d41e8089-074",
          "type": "bullet",
          "text": "クイックドレイン：燃料を抜くための口。やり方は印刷p.45（印刷p.18／PDF 22）"
        },
        {
          "id": "d41e8089-075",
          "type": "bullet",
          "text": "チョークレバー：[始動]／[運転]の2位置（印刷p.18／PDF 22）"
        },
        {
          "id": "d41e8089-076",
          "type": "bullet",
          "text": "リコイルスタータ：主クラッチ切・主変速中立で引いて始動（印刷p.19／PDF 23）"
        },
        {
          "id": "d41e8089-077",
          "type": "bullet",
          "text": "ハンドル高さ調節ノブ：やり方は印刷p.28（印刷p.19／PDF 23）"
        },
        {
          "id": "d41e8089-078",
          "type": "bullet",
          "text": "燃料タンクの規定量：1.4 L（印刷p.19／PDF 23）"
        },
        {
          "id": "d41e8089-079",
          "type": "bullet",
          "text": "前部プロテクタ・ロープ掛け用フック・持ち手：固定・持ち上げ用の部位（印刷p.20／PDF 24）"
        },
        {
          "id": "d41e8089-080",
          "type": "h2",
          "text": "安全に使うために"
        },
        {
          "id": "d41e8089-081",
          "type": "text",
          "text": "安全の章は印刷p.5〜14。作業条件はここでは要約せず、該当頁を指す。"
        },
        {
          "id": "d41e8089-082",
          "type": "bullet",
          "text": "正しい運転方法・運転してはいけない人（16才未満など）・服装：印刷p.5（印刷p.5／PDF 9）"
        },
        {
          "id": "d41e8089-083",
          "type": "bullet",
          "text": "周囲への注意・貸すとき・給油注油の火気厳禁・排ガス：印刷p.6（印刷p.6／PDF 10）"
        },
        {
          "id": "d41e8089-084",
          "type": "bullet",
          "text": "発進・移動・ハウス車庫内・坂道：印刷p.7（印刷p.7／PDF 11）"
        },
        {
          "id": "d41e8089-085",
          "type": "bullet",
          "text": "運搬や積降ろし：印刷p.8（印刷p.8／PDF 12）"
        },
        {
          "id": "d41e8089-086",
          "type": "bullet",
          "text": "乗用車に載せるとき・耕うん作業・回転している爪：印刷p.9（印刷p.9／PDF 13）"
        },
        {
          "id": "d41e8089-087",
          "type": "bullet",
          "text": "ほ場がかたいとき・機械から離れるとき・掃除・点検整備の服装と準備：印刷p.10（印刷p.10／PDF 14）"
        },
        {
          "id": "d41e8089-088",
          "type": "bullet",
          "text": "カバー類・タイヤの確認・改造禁止・格納・廃棄物：印刷p.11（印刷p.11／PDF 15）"
        },
        {
          "id": "d41e8089-089",
          "type": "bullet",
          "text": "夜間作業の禁止：印刷p.12（印刷p.12／PDF 16）"
        },
        {
          "id": "d41e8089-090",
          "type": "bullet",
          "text": "安全ラベルと貼付け位置：印刷p.13（印刷p.13／PDF 17）"
        },
        {
          "id": "d41e8089-091",
          "type": "h2",
          "text": "整備と点検（索引）"
        },
        {
          "id": "d41e8089-092",
          "type": "text",
          "text": "「定期点検箇所一覧表」と「給油一覧表」が同じ頁にある。日常点検の各項目と、必要に応じた調節が続く。"
        },
        {
          "id": "d41e8089-093",
          "type": "bullet",
          "text": "定期点検箇所一覧表：主クラッチケーブル（初期5時間後）／エンジンオイル（初回20時間、以後50時間ごと）／ミッションオイル（初回20時間、以後1年ごと）／エアクリーナ（毎日清掃、50時間ごと交換）／燃料フィルタ（50時間ごと）とタンク（300時間ごと）／点火プラグ（6か月に1回）／燃料チューブ（2年ごと）／タイヤ空気圧（印刷p.36／PDF 40）"
        },
        {
          "id": "d41e8089-094",
          "type": "bullet",
          "text": "給油一覧表：燃料1.4 L／エンジンオイル0.4 L／ミッションオイル1.9 L（印刷p.36／PDF 40）"
        },
        {
          "id": "d41e8089-095",
          "type": "bullet",
          "text": "日常点検（燃料・エンジンオイル）：印刷p.37（印刷p.37／PDF 41）"
        },
        {
          "id": "d41e8089-096",
          "type": "bullet",
          "text": "ミッションオイルの交換・エアクリーナの清掃：印刷p.38（印刷p.38／PDF 42）"
        },
        {
          "id": "d41e8089-097",
          "type": "bullet",
          "text": "燃料フィルタと燃料タンクの清掃・燃料チューブの交換：印刷p.39（印刷p.39／PDF 43）"
        },
        {
          "id": "d41e8089-098",
          "type": "bullet",
          "text": "点火プラグ・ファンカバーの清掃：印刷p.40（印刷p.40／PDF 44）"
        },
        {
          "id": "d41e8089-099",
          "type": "bullet",
          "text": "タイヤの空気圧・主クラッチケーブル・デフ連動ロータリ入切ケーブルの調節：印刷p.41（印刷p.41／PDF 45）"
